{
  "name": "linkedin-auto-connector",
  "version": "1.4.4",
  "private": true,
  "description": "Unit tests for the Job Radar for LinkedIn content script (content.js)",
  "scripts": {
    "test": "jest",
    "test:e2e": "playwright test",
    "test:all": "jest && playwright test"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {},
    "forceExit": true,
    "collectCoverageFrom": [
      "content.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testEnvironmentOptions": {
      "url": "https://www.linkedin.com/search/"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
