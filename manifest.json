{
  "manifest_version": 3,
  "name": "Job Radar for LinkedIn",
  "version": "1.4.0",
  "description": "Find LinkedIn hiring posts, emails & keyword matches. Send connection requests with a safe, configurable delay and live feedback.",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": ["*://*.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Radar for LinkedIn"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["palette.js", "content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
