{
  "manifest_version": 3,
  "name": "LinkedIn Auto-Connector",
  "version": "1.3.0",
  "description": "Auto-send LinkedIn connection requests with visual feedback. Click Connect → Send without note automatically.",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": ["*://*.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Auto-Connector"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["palette.js", "content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
