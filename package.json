{
  "name": "linkedin-auto-connector",
  "version": "1.3.0",
  "private": true,
  "description": "Unit tests for the LinkedIn Auto-Connector content script (content.js)",
  "scripts": {
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {},
    "forceExit": true,
    "collectCoverageFrom": [
      "content.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testEnvironmentOptions": {
      "url": "https://www.linkedin.com/search/"
    }
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}